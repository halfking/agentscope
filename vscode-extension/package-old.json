{
  "name": "agentscope-multi-agent-workflow",
  "displayName": "AgentScope Multi-Agent Workflow",
  "description": "A comprehensive multi-agent programming workflow system powered by AgentScope with real Augment integration",
  "version": "2.0.0",
  "publisher": "agentscope",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Programming Languages"
  ],
  "keywords": [
    "agentscope",
    "multi-agent",
    "ai",
    "code-analysis",
    "quality-check",
    "augment",
    "security",
    "workflow"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentscope.startAgentSystem",
        "title": "Start Agent System",
        "category": "AgentScope"
      },
      {
        "command": "agentscope.stopAgentSystem",
        "title": "Stop Agent System",
        "category": "AgentScope"
      },
      {
        "command": "agentscope.analyzeProject",
        "title": "Analyze Project",
        "category": "AgentScope"
      },
      {
        "command": "agentscope.qualityCheck",
        "title": "Quality Check",
        "category": "AgentScope"
      },
      {
        "command": "agentscope.securityScan",
        "title": "Security Scan",
        "category": "AgentScope"
      },
      {
        "command": "agentscope.showDashboard",
        "title": "Show Agent Dashboard",
        "category": "AgentScope"
      },
      {
        "command": "agentscope.configureAgents",
        "title": "Configure Agents",
        "category": "AgentScope"
      },
      {
        "command": "agentscope.viewTaskHistory",
        "title": "View Task History",
        "category": "AgentScope"
      }
    ],
    "views": {
      "agentscope-explorer": [
        {
          "id": "agentscope.agentStatus",
          "name": "Agent Status",
          "when": "agentscope.systemActive"
        },
        {
          "id": "agentscope.taskQueue",
          "name": "Task Queue",
          "when": "agentscope.systemActive"
        },
        {
          "id": "agentscope.results",
          "name": "Analysis Results",
          "when": "agentscope.systemActive"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentscope-explorer",
          "title": "AgentScope",
          "icon": "$(robot)"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "agentscope.analyzeProject",
          "when": "explorerResourceIsFolder",
          "group": "agentscope@1"
        },
        {
          "command": "agentscope.qualityCheck",
          "when": "resourceExtname =~ /\\.(py|js|ts|java)$/",
          "group": "agentscope@2"
        },
        {
          "command": "agentscope.securityScan",
          "when": "resourceExtname =~ /\\.(py|js|ts|java)$/",
          "group": "agentscope@3"
        }
      ],
      "editor/context": [
        {
          "command": "agentscope.qualityCheck",
          "when": "resourceExtname =~ /\\.(py|js|ts|java)$/",
          "group": "agentscope@1"
        },
        {
          "command": "agentscope.securityScan",
          "when": "resourceExtname =~ /\\.(py|js|ts|java)$/",
          "group": "agentscope@2"
        }
      ],
      "commandPalette": [
        {
          "command": "agentscope.startAgentSystem",
          "when": "!agentscope.systemActive"
        },
        {
          "command": "agentscope.stopAgentSystem",
          "when": "agentscope.systemActive"
        },
        {
          "command": "agentscope.analyzeProject",
          "when": "agentscope.systemActive"
        },
        {
          "command": "agentscope.qualityCheck",
          "when": "agentscope.systemActive"
        },
        {
          "command": "agentscope.securityScan",
          "when": "agentscope.systemActive"
        }
      ]
    },
    "configuration": {
      "title": "AgentScope Multi-Agent Workflow",
      "properties": {
        "agentscope.backend.host": {
          "type": "string",
          "default": "localhost",
          "description": "AgentScope backend host"
        },
        "agentscope.backend.port": {
          "type": "number",
          "default": 8000,
          "description": "AgentScope backend port"
        },
        "agentscope.backend.protocol": {
          "type": "string",
          "enum": ["http", "https"],
          "default": "http",
          "description": "Backend protocol"
        },
        "agentscope.agents.codeManager.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Code Manager Agent"
        },
        "agentscope.agents.complianceAuditor.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Compliance Auditor Agent"
        },
        "agentscope.agents.systemArchitect.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable System Architect Agent"
        },
        "agentscope.llm.provider": {
          "type": "string",
          "enum": ["openai", "anthropic", "siliconflow", "dashscope"],
          "default": "openai",
          "description": "Default LLM provider"
        },
        "agentscope.llm.model": {
          "type": "string",
          "default": "gpt-4",
          "description": "Default LLM model"
        },
        "agentscope.analysis.autoRun": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run analysis on file changes"
        },
        "agentscope.analysis.excludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["node_modules/**", "**/*.min.js", "**/__pycache__/**"],
          "description": "File patterns to exclude from analysis"
        },
        "agentscope.notifications.level": {
          "type": "string",
          "enum": ["error", "warning", "info", "debug"],
          "default": "info",
          "description": "Notification level"
        },
        "agentscope.dashboard.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open dashboard when system starts"
        }
      }
    },
    "keybindings": [
      {
        "command": "agentscope.showDashboard",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "agentscope.analyzeProject",
        "key": "ctrl+shift+p",
        "mac": "cmd+shift+p",
        "when": "agentscope.systemActive"
      },
      {
        "command": "agentscope.qualityCheck",
        "key": "ctrl+shift+q",
        "mac": "cmd+shift+q",
        "when": "agentscope.systemActive && editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.70.0",
    "@types/node": "16.x",
    "@types/ws": "^8.5.0",
    "@typescript-eslint/eslint-plugin": "^5.31.0",
    "@typescript-eslint/parser": "^5.31.0",
    "eslint": "^8.20.0",
    "typescript": "^4.7.4",
    "vsce": "^2.10.0"
  },
  "dependencies": {
    "ws": "^8.13.0",
    "axios": "^1.4.0",
    "uuid": "^9.0.0"
  }
}
