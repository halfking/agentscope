{
  "metadata": {
    "name": "Universal Code Review Standards",
    "version": "1.0.0",
    "description": "通用代码审核标准规范，适用于多种编程语言",
    "created_date": "2024-01-01",
    "last_updated": "2024-01-01",
    "maintainer": "AgentScope Team"
  },
  
  "languages": {
    "python": {
      "name": "Python",
      "file_extensions": [".py", ".pyw"],
      "standards": {
        "code_style": {
          "max_line_length": {
            "value": 120,
            "severity": "warning",
            "description": "单行代码最大长度",
            "rationale": "提高代码可读性，避免水平滚动"
          },
          "indentation": {
            "type": "spaces",
            "size": 4,
            "severity": "error",
            "description": "使用4个空格进行缩进",
            "rationale": "遵循PEP 8标准"
          },
          "blank_lines": {
            "top_level_functions": 2,
            "class_methods": 1,
            "severity": "warning",
            "description": "函数和类之间的空行规范"
          }
        },
        "naming_conventions": {
          "functions": {
            "pattern": "^[a-z_][a-z0-9_]*$",
            "severity": "warning",
            "description": "函数名使用小写字母和下划线",
            "examples": ["get_user_data", "calculate_total"]
          },
          "classes": {
            "pattern": "^[A-Z][a-zA-Z0-9]*$",
            "severity": "warning",
            "description": "类名使用驼峰命名法",
            "examples": ["UserManager", "DataProcessor"]
          },
          "constants": {
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "severity": "warning",
            "description": "常量使用大写字母和下划线",
            "examples": ["MAX_RETRY_COUNT", "DEFAULT_TIMEOUT"]
          },
          "variables": {
            "pattern": "^[a-z_][a-z0-9_]*$",
            "severity": "info",
            "description": "变量名使用小写字母和下划线",
            "examples": ["user_id", "total_count"]
          }
        },
        "complexity_control": {
          "cyclomatic_complexity": {
            "max_value": 10,
            "severity": "warning",
            "description": "函数的圈复杂度不应超过10",
            "rationale": "降低代码复杂度，提高可维护性"
          },
          "max_function_length": {
            "value": 50,
            "severity": "warning",
            "description": "函数最大行数",
            "rationale": "保持函数简洁，单一职责"
          },
          "max_class_length": {
            "value": 500,
            "severity": "info",
            "description": "类最大行数",
            "rationale": "避免过大的类，考虑拆分"
          },
          "max_parameters": {
            "value": 5,
            "severity": "warning",
            "description": "函数参数最大数量",
            "rationale": "减少函数复杂度，考虑使用对象封装"
          }
        },
        "documentation": {
          "require_docstrings": {
            "functions": true,
            "classes": true,
            "modules": true,
            "severity": "warning",
            "description": "要求为函数、类和模块添加文档字符串"
          },
          "docstring_style": {
            "format": "google",
            "severity": "info",
            "description": "使用Google风格的文档字符串"
          }
        },
        "security_practices": {
          "avoid_eval": {
            "severity": "error",
            "description": "避免使用eval()函数",
            "rationale": "eval()可能导致代码注入攻击"
          },
          "avoid_exec": {
            "severity": "error",
            "description": "避免使用exec()函数",
            "rationale": "exec()可能导致代码注入攻击"
          },
          "sql_injection_prevention": {
            "severity": "error",
            "description": "使用参数化查询防止SQL注入",
            "patterns": ["cursor.execute.*%.*", "cursor.execute.*\\+.*"]
          },
          "hardcoded_secrets": {
            "severity": "critical",
            "description": "避免硬编码密钥和密码",
            "patterns": [
              "password\\s*=\\s*['\"][^'\"]+['\"]",
              "api_key\\s*=\\s*['\"][^'\"]+['\"]",
              "secret\\s*=\\s*['\"][^'\"]+['\"]"
            ]
          }
        }
      }
    },
    
    "javascript": {
      "name": "JavaScript",
      "file_extensions": [".js", ".jsx"],
      "standards": {
        "code_style": {
          "max_line_length": {
            "value": 120,
            "severity": "warning",
            "description": "单行代码最大长度"
          },
          "indentation": {
            "type": "spaces",
            "size": 2,
            "severity": "error",
            "description": "使用2个空格进行缩进"
          },
          "semicolons": {
            "required": true,
            "severity": "warning",
            "description": "语句结尾必须使用分号"
          },
          "quotes": {
            "style": "single",
            "severity": "info",
            "description": "优先使用单引号"
          }
        },
        "naming_conventions": {
          "functions": {
            "pattern": "^[a-z][a-zA-Z0-9]*$",
            "severity": "warning",
            "description": "函数名使用驼峰命名法",
            "examples": ["getUserData", "calculateTotal"]
          },
          "classes": {
            "pattern": "^[A-Z][a-zA-Z0-9]*$",
            "severity": "warning",
            "description": "类名使用大驼峰命名法",
            "examples": ["UserManager", "DataProcessor"]
          },
          "constants": {
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "severity": "warning",
            "description": "常量使用大写字母和下划线",
            "examples": ["MAX_RETRY_COUNT", "DEFAULT_TIMEOUT"]
          },
          "variables": {
            "pattern": "^[a-z][a-zA-Z0-9]*$",
            "severity": "info",
            "description": "变量名使用驼峰命名法",
            "examples": ["userId", "totalCount"]
          }
        },
        "complexity_control": {
          "cyclomatic_complexity": {
            "max_value": 10,
            "severity": "warning",
            "description": "函数的圈复杂度不应超过10"
          },
          "max_function_length": {
            "value": 50,
            "severity": "warning",
            "description": "函数最大行数"
          },
          "max_parameters": {
            "value": 4,
            "severity": "warning",
            "description": "函数参数最大数量"
          }
        },
        "best_practices": {
          "use_strict": {
            "required": true,
            "severity": "warning",
            "description": "使用严格模式"
          },
          "avoid_var": {
            "severity": "warning",
            "description": "优先使用let和const，避免使用var"
          },
          "prefer_const": {
            "severity": "info",
            "description": "对于不会重新赋值的变量使用const"
          }
        },
        "security_practices": {
          "avoid_eval": {
            "severity": "error",
            "description": "避免使用eval()函数"
          },
          "xss_prevention": {
            "severity": "error",
            "description": "防止XSS攻击，避免直接操作innerHTML",
            "patterns": ["innerHTML\\s*=", "outerHTML\\s*="]
          },
          "hardcoded_secrets": {
            "severity": "critical",
            "description": "避免硬编码API密钥和敏感信息"
          }
        }
      }
    },
    
    "typescript": {
      "name": "TypeScript",
      "file_extensions": [".ts", ".tsx"],
      "extends": "javascript",
      "standards": {
        "type_safety": {
          "strict_mode": {
            "required": true,
            "severity": "error",
            "description": "启用TypeScript严格模式"
          },
          "explicit_return_types": {
            "required": true,
            "severity": "warning",
            "description": "函数必须显式声明返回类型"
          },
          "no_any": {
            "severity": "warning",
            "description": "避免使用any类型，使用具体类型"
          },
          "prefer_interfaces": {
            "severity": "info",
            "description": "优先使用interface而不是type别名定义对象类型"
          }
        }
      }
    },
    
    "java": {
      "name": "Java",
      "file_extensions": [".java"],
      "standards": {
        "code_style": {
          "max_line_length": {
            "value": 120,
            "severity": "warning",
            "description": "单行代码最大长度"
          },
          "indentation": {
            "type": "spaces",
            "size": 4,
            "severity": "error",
            "description": "使用4个空格进行缩进"
          },
          "brace_style": {
            "style": "egyptian",
            "severity": "warning",
            "description": "使用Egyptian风格的大括号"
          }
        },
        "naming_conventions": {
          "classes": {
            "pattern": "^[A-Z][a-zA-Z0-9]*$",
            "severity": "error",
            "description": "类名使用大驼峰命名法"
          },
          "methods": {
            "pattern": "^[a-z][a-zA-Z0-9]*$",
            "severity": "warning",
            "description": "方法名使用小驼峰命名法"
          },
          "constants": {
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "severity": "warning",
            "description": "常量使用大写字母和下划线"
          },
          "packages": {
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
            "severity": "warning",
            "description": "包名使用小写字母"
          }
        },
        "complexity_control": {
          "cyclomatic_complexity": {
            "max_value": 15,
            "severity": "warning",
            "description": "方法的圈复杂度不应超过15"
          },
          "max_method_length": {
            "value": 60,
            "severity": "warning",
            "description": "方法最大行数"
          },
          "max_class_length": {
            "value": 1000,
            "severity": "info",
            "description": "类最大行数"
          }
        },
        "best_practices": {
          "use_generics": {
            "severity": "warning",
            "description": "使用泛型提高类型安全性"
          },
          "override_annotation": {
            "required": true,
            "severity": "warning",
            "description": "重写方法必须使用@Override注解"
          },
          "final_variables": {
            "severity": "info",
            "description": "对于不会修改的变量使用final关键字"
          }
        },
        "security_practices": {
          "avoid_serialization": {
            "severity": "warning",
            "description": "谨慎使用Java序列化，考虑安全风险"
          },
          "sql_injection_prevention": {
            "severity": "error",
            "description": "使用PreparedStatement防止SQL注入"
          }
        }
      }
    }
  },
  
  "global_rules": {
    "file_organization": {
      "max_file_length": {
        "value": 1000,
        "severity": "warning",
        "description": "单个文件最大行数"
      },
      "import_organization": {
        "group_imports": true,
        "sort_imports": true,
        "severity": "info",
        "description": "导入语句应该分组和排序"
      }
    },
    "performance": {
      "avoid_nested_loops": {
        "max_depth": 3,
        "severity": "warning",
        "description": "避免过深的嵌套循环"
      },
      "efficient_algorithms": {
        "severity": "info",
        "description": "使用高效的算法和数据结构"
      }
    },
    "maintainability": {
      "single_responsibility": {
        "severity": "warning",
        "description": "每个函数/类应该只有一个职责"
      },
      "dry_principle": {
        "severity": "info",
        "description": "避免重复代码，遵循DRY原则"
      },
      "meaningful_names": {
        "severity": "warning",
        "description": "使用有意义的变量和函数名"
      }
    }
  },
  
  "severity_levels": {
    "critical": {
      "level": 1,
      "description": "严重问题，必须立即修复",
      "color": "#ff0000",
      "block_merge": true
    },
    "error": {
      "level": 2,
      "description": "错误，需要修复后才能合并",
      "color": "#ff4444",
      "block_merge": true
    },
    "warning": {
      "level": 3,
      "description": "警告，建议修复",
      "color": "#ffaa00",
      "block_merge": false
    },
    "info": {
      "level": 4,
      "description": "信息，可选修复",
      "color": "#0088ff",
      "block_merge": false
    }
  }
}
